# Copy to .env.local and fill in. Never commit real values.

# --- Browser (bundled into the client; Firebase web config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Server only (/api functions). SECRET — never prefix with VITE_ ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line, with \n for line breaks, wrapped in double quotes
FIREBASE_PRIVATE_KEY=