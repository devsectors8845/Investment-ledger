{
  "name": "investledger-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"api/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "create-super-admin": "node --env-file-if-exists=.env.local scripts/create-super-admin.mjs",
    "emulators": "firebase emulators:start --project demo-investledger --only auth,firestore",
    "test:emulator": "firebase emulators:exec --project demo-investledger --only auth,firestore \"node --test tests/*.test.mjs\"",
    "check:firebase": "node --env-file-if-exists=.env.local scripts/check-firebase.mjs"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
